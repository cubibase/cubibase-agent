{
  "name": "@cubibasehq/cli",
  "version": "0.2.2",
  "description": "CubiBase CLI for developers and AI agents: projects, schema, rows, SQL, storage, functions, logs \u2014 JSON output by default",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cubibase": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "references"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubibase/cubibase-agent.git",
    "directory": "packages/cli"
  },
  "homepage": "https://cubibase.com/docs/agents",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cubibasehq/client": "0.2.2"
  }
}
