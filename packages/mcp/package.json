{
  "name": "@cubibasehq/mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server for CubiBase: projects, schema, rows, SQL, logs, and Data API access for AI agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cubibase-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubibase/cubibase-agent.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://cubibase.com/docs/agents",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cubibasehq/client": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.24.0"
  }
}